rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Crop disease scan images: owner can upload/read, images are private.
    match /crop-scans/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Marketplace listing images: publicly readable, owner can upload.
    match /listings/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
